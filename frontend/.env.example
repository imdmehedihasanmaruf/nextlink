# Frontend Environment Variables

# API Configuration
# Use the API root; the client adds /v1 to every request.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
# Legacy fallback; keep this at the same API root if used.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Authentication is enforced by Laravel; do not put private credentials here.

# Never place passwords, API tokens, or payment credentials in NEXT_PUBLIC variables.
