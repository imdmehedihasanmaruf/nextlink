# The portal is served on port 3000. It reaches the Express API through the
# same-origin /api proxy on this app (port 3000). Leave NEXT_PUBLIC_BILLING_API_URL
# empty to use that proxy. Set it to an absolute URL only if the API is served
# on a different origin.
NEXT_PUBLIC_BILLING_API_URL=

# Server-to-server only — used by Next API routes to verify tokens and
# delegate calls to Express. Never exposed to the browser.
INTERNAL_API_URL=http://localhost:3100
