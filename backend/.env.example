NEXT_PUBLIC_APP_NAME=NextLink Admin
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_API_URL=/api
# Admin reaches Express through the Next.js /api proxy on this app
# (port 8000) by default. Leave NEXT_PUBLIC_BILLING_API_URL empty to use the
# same-origin proxy, or set it to an absolute URL for a separate API origin.
NEXT_PUBLIC_BILLING_API_URL=
# Server-to-server only — used by Next API routes and server-side helpers
# to verify tokens and delegate to Express. Never exposed to the browser.
INTERNAL_API_URL=http://localhost:3100

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/nextlink_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=nextlink_db
PGUSER=postgres
PGPASSWORD=YOUR_PASSWORD
