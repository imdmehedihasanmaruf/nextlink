# ============================================================================
# NextLink Express API — production environment template
#
# Copy to `.env` on the server and fill in the real values.
# NEVER commit the filled-in file.
#
# Only the values marked [REQUIRED FOR LIVE] are needed to switch an
# integration from its simulator/mock mode to the real thing.
# ============================================================================

# --- Server -----------------------------------------------------------------
PORT=3001
NODE_ENV=production
API_BASE_URL=https://api.your-domain.com

# --- PostgreSQL -------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/nextlink_db
PGHOST=HOST
PGPORT=5432
PGDATABASE=nextlink_db
PGUSER=USER
PGPASSWORD=PASSWORD

# --- Redis (session & active queues) ---------------------------------------
# [REQUIRED FOR LIVE] Redis must be reachable for a multi-node deployment.
REDIS_URL=redis://:PASSWORD@HOST:6379
REDIS_ENABLED=true

# --- JWT --------------------------------------------------------------------
# [REQUIRED FOR LIVE] Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d

# ============================================================================
# MikroTik RouterOS
# ============================================================================
# [REQUIRED FOR LIVE] Set the mode to "live" and fill in the router details.
MIKROTIK_MODE=simulator
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_TLS_PORT=8729
MIKROTIK_USER=nextlink_api
MIKROTIK_PASSWORD=
MIKROTIK_TIMEOUT_MS=8000

# ============================================================================
# Payment gateways
# ============================================================================
# [REQUIRED FOR LIVE] Set PAYMENT_MODE=live and fill in the merchant accounts.
PAYMENT_MODE=mock

# --- bKash Tokenized Checkout (v1.2.0-beta) ---
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
# Production endpoint: https://tokenized.pay.bka.sh/v1.2.0-beta

# --- Nagad ---
NAGAD_BASE_URL=https://api.sandbox.nagad.com
NAGAD_MERCHANT_ID=
NAGAD_API_KEY=

# --- SSLCommerz ---
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
# Production endpoint: https://securepay.sslcommerz.com

# --- Rocket ---
ROCKET_BASE_URL=https://sandbox.rocket.com/api/v1
ROCKET_MERCHANT_ID=
ROCKET_API_KEY=

# ============================================================================
# SMS gateway
# ============================================================================
# [REQUIRED FOR LIVE] The provider must accept a JSON POST with
# { to, message, sender_id } and answer { id | message_id }.
SMS_MODE=mock
SMS_PROVIDER_URL=https://sms-gateway.your-domain.com/api/send
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=NextLink

# ============================================================================
# Billing engine
# ============================================================================
BILLING_TIMEZONE=Asia/Dhaka
BILLING_DUE_DAY=10
BILLING_LATE_GRACE_DAYS=5
BILLING_SUSPEND_AFTER_DAYS=10
BILLING_CURRENCY=BDT
BILLING_CURRENCY_SYMBOL=৳
BILLING_PDF_DIR=./storage/invoices

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com
