# NextLink Express API — environment template
# Copy to .env and fill in real values. NEVER commit .env

# --- Server ---
PORT=3001
NODE_ENV=development
API_BASE_URL=http://localhost:3001

# --- PostgreSQL (core data) ---
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/nextlink_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=nextlink_db
PGUSER=postgres
PGPASSWORD=CHANGE_ME

# --- Redis (session & active queues) ---
# Leave REDIS_URL empty to use the built-in in-process queue (single-node dev only)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# --- JWT (API auth for admin/staff) ---
JWT_SECRET=CHANGE_ME_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- MikroTik RouterOS ---
# MIKROTIK_MODE=simulator | live
MIKROTIK_MODE=simulator
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_TLS_PORT=8729
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=
MIKROTIK_TIMEOUT_MS=8000

# --- Payment gateways ---
# PAYMENT_MODE=mock | live
PAYMENT_MODE=mock
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
NAGAD_BASE_URL=https://sandboxapi.sslcommerz.com
NAGAD_MERCHANT_ID=
NAGAD_API_KEY=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
ROCKET_MERCHANT_ID=
ROCKET_API_KEY=
ROCKET_BASE_URL=https://sandbox.rocket.com/api/v1

# --- SMS gateway ---
# SMS_MODE=mock | live
SMS_MODE=mock
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=NextLink

# --- Billing engine ---
BILLING_TIMEZONE=Asia/Dhaka
BILLING_DUE_DAY=10
BILLING_LATE_GRACE_DAYS=5
BILLING_SUSPEND_AFTER_DAYS=10
BILLING_PDF_DIR=./storage/invoices
BILLING_CURRENCY=BDT
BILLING_CURRENCY_SYMBOL=৳
BILLING_CURRENCY_SYMBOL_SMS=BDT

# --- Frontend origin allowed by CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
