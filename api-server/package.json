{
  "name": "nextlink-api",
  "version": "1.0.0",
  "private": true,
  "description": "NextLink ISP Management System — Express REST API (Backend Engine)",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --watch-path=src src/server.js",
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:passwords": "node scripts/migrate-passwords.js",
    "seed:coverage": "node scripts/seed-coverage.js",
    "diagnose": "node scripts/diagnose.js",
    "diagnose:live": "node scripts/diagnose.js --live",
    "live:demo": "node scripts/run-live-demo.js",
    "mock:routeros": "node scripts/mock-routeros-server.js",
    "mock:gateways": "node scripts/mock-gateway-server.js",
    "test": "node scripts/test-e2e.js && node scripts/test-portal.js && node scripts/test-automation.js && node scripts/test-phase12.js && node scripts/test-credentials.js",
    "test:live": "node scripts/test-live-mode.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  }
}
